generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  BANK_ACCOUNT
  CREDIT_CARD
}

enum SourceType {
  ICICI_BANK
  ICICI_AMAZON_PAY_CARD
}

enum ImportStatus {
  PENDING
  PARSED
  FAILED
  COMPLETED
}

enum ExpenseType {
  EXPENSE
  TRANSFER
  INVESTMENT
  INCOME
  REFUND
  REVIEW
}

enum MatchType {
  CONTAINS
  REGEX
  EXACT
  STARTS_WITH
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id                 String       @id @default(cuid())
  googleSubject      String?      @unique
  email              String       @unique
  name               String?
  avatarUrl          String?
  role               Role         @default(MEMBER)
  accounts           Account[]
  imports            Import[]
  transactions       Transaction[]
  rules              Rule[]
  sessions           Session[]
  invitationsCreated Invitation[] @relation("InvitationCreator")
  invitationAccepted Invitation?  @relation("InvitationAccepted")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  lastSignedInAt     DateTime?
}

model Invitation {
  id           String    @id @default(cuid())
  email        String    @unique
  role         Role      @default(MEMBER)
  invitedById  String
  invitedBy    User      @relation("InvitationCreator", fields: [invitedById], references: [id])
  acceptedById String?   @unique
  acceptedBy   User?     @relation("InvitationAccepted", fields: [acceptedById], references: [id])
  createdAt    DateTime  @default(now())
  usedAt       DateTime?
  revokedAt    DateTime?

  @@index([invitedById])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  name         String
  institution  String
  type         AccountType
  lastFour     String?
  imports      Import[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([id, userId])
  @@index([userId])
}

model Import {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  accountId     String
  account       Account      @relation(fields: [accountId, userId], references: [id, userId])
  sourceType    SourceType
  fileName      String
  fileHash      String
  statementFrom DateTime?
  statementTo   DateTime?
  status        ImportStatus @default(PENDING)
  totalRows     Int          @default(0)
  importedRows  Int          @default(0)
  duplicateRows Int          @default(0)
  failedRows    Int          @default(0)
  errorMessage  String?
  transactions  Transaction[]
  createdAt     DateTime     @default(now())

  @@unique([fileHash, accountId])
  @@unique([id, userId])
  @@index([userId, createdAt])
}

model Transaction {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  accountId        String
  account          Account     @relation(fields: [accountId, userId], references: [id, userId])
  importId         String
  import           Import      @relation(fields: [importId, userId], references: [id, userId])
  transactionDate  DateTime
  descriptionRaw   String
  descriptionClean String
  moneyOut         Decimal     @db.Decimal(14, 2)
  moneyIn          Decimal     @db.Decimal(14, 2)
  netAmount        Decimal     @db.Decimal(14, 2)
  balance          Decimal?    @db.Decimal(14, 2)
  referenceNumber  String?
  transactionHash  String
  sourceType       SourceType
  paymentMethod    String?
  category         TransactionCategory?
  createdAt        DateTime    @default(now())

  @@unique([userId, transactionHash])
  @@index([userId, transactionDate])
  @@index([userId, accountId])
  @@index([userId, sourceType])
}

model TransactionCategory {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  vendor        String
  category      String
  subcategory   String?
  expenseType   ExpenseType
  ruleId        String?
  rule          Rule?       @relation(fields: [ruleId], references: [id])
  confidence    Int         @default(100)
  isManual      Boolean     @default(false)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Rule {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  priority    Int
  matchType   MatchType
  pattern     String
  vendor      String
  category    String
  subcategory String?
  expenseType ExpenseType
  isActive    Boolean     @default(true)
  categories  TransactionCategory[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, priority])
  @@index([userId, isActive])
}
