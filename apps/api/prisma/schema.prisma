generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  BANK_ACCOUNT
  CREDIT_CARD
}

enum SourceType {
  ICICI_BANK
  ICICI_AMAZON_PAY_CARD
}

enum ImportStatus {
  PENDING
  PARSED
  FAILED
  COMPLETED
}

enum ExpenseType {
  EXPENSE
  TRANSFER
  INVESTMENT
  INCOME
  REFUND
  REVIEW
}

enum MatchType {
  CONTAINS
  REGEX
  EXACT
  STARTS_WITH
}

enum Role {
  ADMIN
  MEMBER
}

enum BrokerProvider {
  DHAN
}

enum InstrumentLifecycleStatus {
  ACTIVE
  INACTIVE
  DELISTED
  RENAMED
}

enum InstrumentMasterSyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum PortfolioAssetClass {
  STOCK
  ETF
  CASH
  MUTUAL_FUND
  UNKNOWN
}

model User {
  id                      String                   @id @default(cuid())
  googleSubject           String?                  @unique
  email                   String                   @unique
  name                    String?
  avatarUrl               String?
  role                    Role                     @default(MEMBER)
  accounts                Account[]
  imports                 Import[]
  transactions            Transaction[]
  rules                   Rule[]
  sessions                Session[]
  brokerAccounts          BrokerAccount[]
  brokerConnections       BrokerConnection[]
  brokerCredentials       BrokerCredential[]
  brokerHoldingSnapshots  BrokerHoldingSnapshot[]
  brokerPositionSnapshots BrokerPositionSnapshot[]
  brokerOrderSnapshots    BrokerOrderSnapshot[]
  brokerTradeSnapshots    BrokerTradeSnapshot[]
  brokerFundSnapshots     BrokerFundSnapshot[]
  mutualFundHoldings      MutualFundHolding[]
  mutualFundNavs          MutualFundNav[]
  portfolioSnapshots      PortfolioSnapshot[]
  swingScanRuns           SwingScanRun[]
  tradeJournalEntries     TradeJournalEntry[]
  researchItems           ResearchItem[]
  researchSnapshots       ResearchSnapshot[]
  toolExecutionAudits     ToolExecutionAudit[]
  mcpAccessTokens         McpAccessToken[]
  invitationsCreated      Invitation[]             @relation("InvitationCreator")
  invitationAccepted      Invitation?              @relation("InvitationAccepted")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  lastSignedInAt          DateTime?
}

model Invitation {
  id           String    @id @default(cuid())
  email        String    @unique
  role         Role      @default(MEMBER)
  invitedById  String
  invitedBy    User      @relation("InvitationCreator", fields: [invitedById], references: [id])
  acceptedById String?   @unique
  acceptedBy   User?     @relation("InvitationAccepted", fields: [acceptedById], references: [id])
  createdAt    DateTime  @default(now())
  usedAt       DateTime?
  revokedAt    DateTime?

  @@index([invitedById])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  name         String
  institution  String
  type         AccountType
  lastFour     String?
  imports      Import[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([id, userId])
  @@index([userId])
}

model Import {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  accountId     String
  account       Account      @relation(fields: [accountId, userId], references: [id, userId])
  sourceType    SourceType
  fileName      String
  fileHash      String
  statementFrom DateTime?
  statementTo   DateTime?
  status        ImportStatus @default(PENDING)
  totalRows     Int          @default(0)
  importedRows  Int          @default(0)
  duplicateRows Int          @default(0)
  failedRows    Int          @default(0)
  errorMessage  String?
  transactions  Transaction[]
  createdAt     DateTime     @default(now())

  @@unique([fileHash, accountId])
  @@unique([id, userId])
  @@index([userId, createdAt])
}

model Transaction {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  accountId        String
  account          Account     @relation(fields: [accountId, userId], references: [id, userId])
  importId         String
  import           Import      @relation(fields: [importId, userId], references: [id, userId])
  transactionDate  DateTime
  descriptionRaw   String
  descriptionClean String
  moneyOut         Decimal     @db.Decimal(14, 2)
  moneyIn          Decimal     @db.Decimal(14, 2)
  netAmount        Decimal     @db.Decimal(14, 2)
  balance          Decimal?    @db.Decimal(14, 2)
  referenceNumber  String?
  transactionHash  String
  sourceType       SourceType
  paymentMethod    String?
  category         TransactionCategory?
  createdAt        DateTime    @default(now())

  @@unique([userId, transactionHash])
  @@index([userId, transactionDate])
  @@index([userId, accountId])
  @@index([userId, sourceType])
}

model TransactionCategory {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  vendor        String
  category      String
  subcategory   String?
  expenseType   ExpenseType
  ruleId        String?
  rule          Rule?       @relation(fields: [ruleId], references: [id])
  confidence    Int         @default(100)
  isManual      Boolean     @default(false)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Rule {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  priority    Int
  matchType   MatchType
  pattern     String
  vendor      String
  category    String
  subcategory String?
  expenseType ExpenseType
  isActive    Boolean     @default(true)
  categories  TransactionCategory[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, priority])
  @@index([userId, isActive])
}

model BrokerAccount {
  id                     String                   @id @default(cuid())
  userId                 String
  user                   User                     @relation(fields: [userId], references: [id])
  provider               BrokerProvider
  displayName            String
  dhanClientId           String
  isActive               Boolean                  @default(true)
  holdingSnapshots       BrokerHoldingSnapshot[]
  positionSnapshots      BrokerPositionSnapshot[]
  orderSnapshots         BrokerOrderSnapshot[]
  tradeSnapshots         BrokerTradeSnapshot[]
  fundSnapshots          BrokerFundSnapshot[]
  portfolioSnapshots     PortfolioSnapshot[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@unique([id, userId])
  @@unique([userId, provider, dhanClientId])
  @@index([userId, provider])
}

model BrokerConnection {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           BrokerProvider
  brokerName         String
  displayName        String
  clientIdMasked     String?
  apiKeyMasked       String?
  metadata           Json?
  status             String             @default("DISCONNECTED")
  lastValidatedAt    DateTime?
  lastSyncAt         DateTime?
  accessTokenExpiresAt DateTime?
  credentials        BrokerCredential[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([userId, provider])
  @@index([userId, status])
}

model BrokerCredential {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerConnectionId String
  brokerConnection   BrokerConnection @relation(fields: [brokerConnectionId], references: [id], onDelete: Cascade)
  credentialType     String
  ciphertext         String
  iv                 String
  authTag            String
  keyVersion         String           @default("v1")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([brokerConnectionId, credentialType])
  @@index([userId, credentialType])
}

model BrokerHoldingSnapshot {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  brokerAccountId   String
  brokerAccount     BrokerAccount       @relation(fields: [brokerAccountId, userId], references: [id, userId])
  syncRunId         String
  asOf              DateTime
  provider          BrokerProvider      @default(DHAN)
  exchange          String?
  tradingSymbol     String
  securityId        String
  isin              String?
  assetClass        PortfolioAssetClass @default(STOCK)
  totalQty          Decimal             @db.Decimal(18, 6)
  dpQty             Decimal             @db.Decimal(18, 6)
  t1Qty             Decimal             @db.Decimal(18, 6)
  availableQty      Decimal             @db.Decimal(18, 6)
  collateralQty     Decimal             @db.Decimal(18, 6)
  avgCostPrice      Decimal             @db.Decimal(14, 4)
  costValue         Decimal             @db.Decimal(18, 2)
  marketValue       Decimal             @db.Decimal(18, 2)
  rawPayload        Json
  createdAt         DateTime            @default(now())

  @@index([userId, asOf])
  @@index([userId, tradingSymbol])
  @@index([brokerAccountId, asOf])
  @@index([syncRunId])
}

model BrokerPositionSnapshot {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id])
  brokerAccountId       String
  brokerAccount         BrokerAccount  @relation(fields: [brokerAccountId, userId], references: [id, userId])
  syncRunId             String
  asOf                  DateTime
  provider              BrokerProvider @default(DHAN)
  dhanClientId          String?
  tradingSymbol         String
  securityId            String
  positionType          String?
  exchangeSegment       String?
  productType           String?
  buyAvg                Decimal        @db.Decimal(14, 4)
  buyQty                Decimal        @db.Decimal(18, 6)
  costPrice             Decimal        @db.Decimal(14, 4)
  sellAvg               Decimal        @db.Decimal(14, 4)
  sellQty               Decimal        @db.Decimal(18, 6)
  netQty                Decimal        @db.Decimal(18, 6)
  realizedProfit        Decimal        @db.Decimal(18, 2)
  unrealizedProfit      Decimal        @db.Decimal(18, 2)
  carryForwardBuyQty    Decimal        @db.Decimal(18, 6)
  carryForwardSellQty   Decimal        @db.Decimal(18, 6)
  dayBuyQty             Decimal        @db.Decimal(18, 6)
  daySellQty            Decimal        @db.Decimal(18, 6)
  dayBuyValue           Decimal        @db.Decimal(18, 2)
  daySellValue          Decimal        @db.Decimal(18, 2)
  rawPayload            Json
  createdAt             DateTime       @default(now())

  @@index([userId, asOf])
  @@index([userId, tradingSymbol])
  @@index([brokerAccountId, asOf])
  @@index([syncRunId])
}

model BrokerOrderSnapshot {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id])
  brokerAccountId     String
  brokerAccount       BrokerAccount  @relation(fields: [brokerAccountId, userId], references: [id, userId])
  syncRunId           String
  asOf                DateTime
  provider            BrokerProvider @default(DHAN)
  dhanClientId        String?
  orderId             String
  correlationId       String?
  orderStatus         String?
  transactionType     String?
  exchangeSegment     String?
  productType         String?
  orderType           String?
  validity            String?
  tradingSymbol       String?
  securityId          String?
  quantity            Decimal        @db.Decimal(18, 6)
  price               Decimal        @db.Decimal(14, 4)
  triggerPrice        Decimal        @db.Decimal(14, 4)
  remainingQuantity   Decimal        @db.Decimal(18, 6)
  averageTradedPrice  Decimal        @db.Decimal(14, 4)
  filledQty           Decimal        @db.Decimal(18, 6)
  createTime          DateTime?
  updateTime          DateTime?
  exchangeTime        DateTime?
  rawPayload          Json
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([brokerAccountId, orderId])
  @@index([userId, asOf])
  @@index([userId, orderStatus])
  @@index([brokerAccountId, asOf])
  @@index([syncRunId])
}

model BrokerTradeSnapshot {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id])
  brokerAccountId     String
  brokerAccount       BrokerAccount  @relation(fields: [brokerAccountId, userId], references: [id, userId])
  syncRunId           String
  asOf                DateTime
  provider            BrokerProvider @default(DHAN)
  dhanClientId        String?
  orderId             String
  exchangeOrderId     String?
  exchangeTradeId     String
  transactionType     String?
  exchangeSegment     String?
  productType         String?
  orderType           String?
  tradingSymbol       String?
  securityId          String?
  tradedQuantity      Decimal        @db.Decimal(18, 6)
  tradedPrice         Decimal        @db.Decimal(14, 4)
  createTime          DateTime?
  updateTime          DateTime?
  exchangeTime        DateTime?
  rawPayload          Json
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([brokerAccountId, exchangeTradeId])
  @@index([userId, asOf])
  @@index([userId, tradingSymbol])
  @@index([brokerAccountId, asOf])
  @@index([syncRunId])
}

model BrokerFundSnapshot {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id])
  brokerAccountId     String
  brokerAccount       BrokerAccount  @relation(fields: [brokerAccountId, userId], references: [id, userId])
  syncRunId           String
  asOf                DateTime
  provider            BrokerProvider @default(DHAN)
  dhanClientId        String?
  availableBalance    Decimal        @db.Decimal(18, 2)
  sodLimit            Decimal        @db.Decimal(18, 2)
  collateralAmount    Decimal        @db.Decimal(18, 2)
  receivableAmount    Decimal        @db.Decimal(18, 2)
  utilizedAmount      Decimal        @db.Decimal(18, 2)
  blockedPayoutAmount Decimal        @db.Decimal(18, 2)
  withdrawableBalance Decimal        @db.Decimal(18, 2)
  rawPayload          Json
  createdAt           DateTime       @default(now())

  @@index([userId, asOf])
  @@index([brokerAccountId, asOf])
  @@index([syncRunId])
}

model MutualFundHolding {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  schemeCode    String?
  schemeName    String
  folioLastFour String?
  units         Decimal  @db.Decimal(18, 6)
  avgCostNav    Decimal? @db.Decimal(14, 4)
  costValue     Decimal? @db.Decimal(18, 2)
  rawPayload    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, schemeCode])
  @@index([userId, schemeName])
}

model MutualFundNav {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  schemeCode  String
  schemeName  String
  nav         Decimal  @db.Decimal(14, 4)
  navDate     DateTime
  source      String
  rawPayload  Json?
  createdAt   DateTime @default(now())

  @@unique([userId, schemeCode, navDate])
  @@index([userId, navDate])
}

model PortfolioSnapshot {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  brokerAccountId String?
  brokerAccount   BrokerAccount? @relation(fields: [brokerAccountId, userId], references: [id, userId], onDelete: Restrict)
  snapshotTime    DateTime       @default(now())
  totalStockValue Decimal        @db.Decimal(18, 2)
  totalEtfValue   Decimal        @db.Decimal(18, 2)
  totalMfValue    Decimal        @default(0) @db.Decimal(18, 2)
  totalCashValue  Decimal        @db.Decimal(18, 2)
  totalValue      Decimal        @db.Decimal(18, 2)
  allocation      Json
  source          Json
  warnings        String[]
  createdAt       DateTime       @default(now())

  @@index([userId, snapshotTime])
  @@index([brokerAccountId, snapshotTime])
}

model InstrumentMasterEntry {
  id                     String                    @id @default(cuid())
  securityId             String
  exchange               String
  segment                String
  symbol                 String
  displayName            String
  isin                   String?
  instrumentName         String
  instrumentType         String
  series                 String?
  lifecycleStatus        InstrumentLifecycleStatus @default(ACTIVE)
  supersededBySymbol     String?
  supersededBySecurityId String?
  buySellIndicator       String?
  source                 String                    @default("DHAN_SCRIP_MASTER")
  sourceRowHash          String
  rawMetadata            Json
  firstSeenAt            DateTime                  @default(now())
  lastSeenAt             DateTime
  instruments            Instrument[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@unique([exchange, securityId])
  @@index([symbol, exchange])
  @@index([isin])
  @@index([lifecycleStatus])
}

model InstrumentMasterSyncRun {
  id               String                     @id @default(cuid())
  status           InstrumentMasterSyncStatus
  sourceUrl        String
  contentHash      String?
  startedAt        DateTime                   @default(now())
  completedAt      DateTime?
  fetchedAt        DateTime?
  rowCount         Int                        @default(0)
  upsertedCount    Int                        @default(0)
  deactivatedCount Int                        @default(0)
  conflictCount    Int                        @default(0)
  skippedCount     Int                        @default(0)
  errorMessage     String?
  rawMetadata      Json?
  createdAt        DateTime                   @default(now())

  @@index([startedAt])
  @@index([status])
}

model Instrument {
  id                  String                       @id @default(cuid())
  symbol              String
  exchange            String
  securityId          String?
  isin                String?
  name                String
  instrumentType      String
  sector              String?
  industry            String?
  isActive            Boolean                      @default(true)
  lifecycleStatus     InstrumentLifecycleStatus?
  masterEntryId       String?
  masterEntry         InstrumentMasterEntry?       @relation(fields: [masterEntryId], references: [id], onDelete: SetNull)
  source              String
  lastVerifiedAt      DateTime?
  priceSnapshots      PriceSnapshot[]
  dailyCandles        DailyCandle[]
  indicatorSnapshots  TechnicalIndicatorSnapshot[]
  dataQualityWarnings DataQualityWarning[]
  researchItems       ResearchItem[]
  researchSnapshots   ResearchSnapshot[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@unique([symbol, exchange])
  @@index([securityId, exchange])
  @@index([isin])
  @@index([symbol])
  @@index([masterEntryId])
}

model PriceSnapshot {
  id             String     @id @default(cuid())
  instrumentId   String
  instrument     Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  ltp            Decimal    @db.Decimal(14, 4)
  open           Decimal?   @db.Decimal(14, 4)
  high           Decimal?   @db.Decimal(14, 4)
  low            Decimal?   @db.Decimal(14, 4)
  previousClose  Decimal?   @db.Decimal(14, 4)
  volume         BigInt?
  source         String
  timestamp      DateTime
  freshness      String
  dataQuality    Json
  warnings       String[]
  rawPayload     Json?
  createdAt      DateTime   @default(now())

  @@index([instrumentId, timestamp])
  @@index([source, timestamp])
}

model DailyCandle {
  id            String     @id @default(cuid())
  instrumentId  String
  instrument    Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  date          DateTime
  open          Decimal    @db.Decimal(14, 4)
  high          Decimal    @db.Decimal(14, 4)
  low           Decimal    @db.Decimal(14, 4)
  close         Decimal    @db.Decimal(14, 4)
  volume        BigInt?
  source        String
  isAdjusted    Boolean    @default(false)
  dataQuality   Json?
  warnings      String[]
  rawPayload    Json?
  createdAt     DateTime   @default(now())

  @@unique([instrumentId, date, source])
  @@index([instrumentId, date])
}

model TechnicalIndicatorSnapshot {
  id                String     @id @default(cuid())
  instrumentId      String
  instrument        Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  asOfDate          DateTime
  sma20             Decimal?   @db.Decimal(14, 4)
  sma50             Decimal?   @db.Decimal(14, 4)
  sma200            Decimal?   @db.Decimal(14, 4)
  rsi14             Decimal?   @db.Decimal(8, 4)
  atr14             Decimal?   @db.Decimal(14, 4)
  volumeAverage20   Decimal?   @db.Decimal(18, 4)
  volumeRatio       Decimal?   @db.Decimal(10, 4)
  distanceFromSma50 Decimal?   @db.Decimal(10, 4)
  source            String
  dataQuality       Json
  warnings          String[]
  createdAt         DateTime   @default(now())

  @@unique([instrumentId, asOfDate, source])
  @@index([instrumentId, asOfDate])
}

model DataQualityWarning {
  id           String      @id @default(cuid())
  instrumentId String?
  instrument   Instrument? @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  scope        String
  code         String
  message      String
  severity     String
  source       String
  asOf         DateTime
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([instrumentId, asOf])
  @@index([scope, code])
}

model SwingScanRun {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  runAt           DateTime @default(now())
  universeSource  String
  universe        String[]
  candidateCount  Int
  candidates      Json
  warnings        String[]
  createdAt       DateTime @default(now())

  @@index([userId, runAt])
}

enum TradeJournalEntryStatus {
  PLANNED
  ACTIVE
  CLOSED
  CANCELLED
}

enum TradeJournalSource {
  MANUAL
  FROM_SCANNER
}

model TradeJournalEntry {
  id                  String                  @id @default(cuid())
  userId              String
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol              String
  side                String                  @default("BUY")
  product             String                  @default("DELIVERY")
  plannedEntry        Decimal                 @db.Decimal(14, 4)
  plannedTarget       Decimal                 @db.Decimal(14, 4)
  plannedStopLoss     Decimal                 @db.Decimal(14, 4)
  quantity            Int
  setupType           String?
  status              TradeJournalEntryStatus @default(PLANNED)
  notes               String?
  source              TradeJournalSource      @default(MANUAL)
  swingScanRunId      String?
  scannerCandidateKey String?
  validationSnapshot  Json?
  dataQuality         Json?
  exitPrice           Decimal?                @db.Decimal(14, 4)
  exitAt              DateTime?
  actualPnl           Decimal?                @db.Decimal(18, 2)
  exitReason          String?
  mistakeTags         String[]
  lessonLearned       String?
  closedAt            DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([userId, status])
  @@index([userId, symbol])
  @@index([userId, createdAt])
}

enum ResearchCategory {
  RESULT
  ORDER_WIN
  CORPORATE_ACTION
  REGULATORY
  MANAGEMENT_COMMENTARY
  SECTOR_NEWS
  COMPANY_NEWS
  USER_NOTE
  RISK_FLAG
  OTHER
}

enum ResearchImpact {
  POSITIVE
  NEGATIVE
  NEUTRAL
  MIXED
  UNKNOWN
}

model ResearchItem {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrumentId String?
  instrument   Instrument?      @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  symbol       String
  title        String
  summary      String
  category     ResearchCategory
  impact       ResearchImpact
  sourceType   String
  sourceName   String
  sourceUrl    String?
  publishedAt  DateTime?
  fetchedAt    DateTime         @default(now())
  asOf         DateTime         @default(now())
  confidence   Decimal          @default(0.8) @db.Decimal(5, 4)
  rawPayload   Json?
  evidence     ResearchEvidence[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId, symbol])
  @@index([userId, symbol, category])
  @@index([userId, symbol, impact])
  @@index([instrumentId])
}

model ResearchEvidence {
  id             String       @id @default(cuid())
  researchItemId String
  researchItem   ResearchItem @relation(fields: [researchItemId], references: [id], onDelete: Cascade)
  label          String
  value          String
  unit           String?
  evidenceDate   DateTime?
  sourceUrl      String?
  createdAt      DateTime     @default(now())

  @@index([researchItemId])
}

model ResearchSnapshot {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrumentId      String?
  instrument        Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  symbol            String
  asOf              DateTime    @default(now())
  latestEvidenceAt  DateTime?
  hasFreshEvidence  Boolean     @default(false)
  staleReason       String?
  positiveCount     Int         @default(0)
  negativeCount     Int         @default(0)
  neutralCount      Int         @default(0)
  riskFlags         Json        @default("[]")
  summary           String
  warnings          Json        @default("[]")
  createdAt         DateTime    @default(now())

  @@index([userId, symbol, createdAt])
  @@index([instrumentId])
}

enum ToolExecutionStatus {
  OK
  REJECTED
  UNAVAILABLE
  ERROR
}

/// Persisted metadata for internal read-only tool executions.
/// Retention: prune rows older than 90 days via scheduled job (not yet implemented).
/// Indexes support per-user history and tool-name filtering.
model ToolExecutionAudit {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolName     String
  toolVersion  String
  status       ToolExecutionStatus
  startedAt    DateTime
  completedAt  DateTime?
  durationMs   Int?
  inputHash    String?
  inputMeta    Json?
  warningCount Int                 @default(0)
  rejectCount  Int                 @default(0)
  errorCode    String?
  createdAt    DateTime            @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, toolName, createdAt(sort: Desc)])
  @@index([createdAt])
}

/// Revocable bearer credentials for MCP clients. Maps one token to one user.
model McpAccessToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String?
  tokenHash   String    @unique
  tokenPrefix String
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([revokedAt])
  @@index([expiresAt])
}
